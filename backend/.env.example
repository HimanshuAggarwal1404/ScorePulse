# ---------- Database ----------
# Hosted Postgres (Neon, Render, Supabase ...): one connection string, TLS on automatically
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local Postgres: separate settings (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=scorepulse
DB_PORT=5432
# DB_SSL=false        # turn TLS off for a local DATABASE_URL
# DB_POOL_MAX=10

# ---------- Server ----------
PORT=8000
# NODE_ENV=production

# Comma-separated sites allowed to call the API; "*" matches one subdomain label
# (e.g. Vercel preview deploys). Unset = any origin (fine locally, not in production).
# CORS_ORIGIN=https://scorepulse.vercel.app,https://scorepulse-*.vercel.app

# Protects /api/scoring (the scorer console asks for it once). Required in production:
# without it the console is locked. Use a long random string, e.g. `openssl rand -hex 24`.
SCORER_KEY=

# Optional tuning: requests per IP per 5 minutes
# RATE_LIMIT_API=900
# RATE_LIMIT_SCORING=300
